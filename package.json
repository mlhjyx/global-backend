{
  "name": "global-backend",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:dev": "pnpm --filter @global/api start:dev",
    "api:build": "pnpm --filter @global/api build",
    "infra:up": "docker compose -p global up -d",
    "infra:down": "docker compose -p global down",
    "infra:ai-observability:config": "docker compose --env-file .secrets/ai-observability.env -p global -f docker-compose.yml -f infra/ai-observability.compose.yml --profile ai-observability config --quiet",
    "infra:ai-observability:up": "docker compose --env-file .secrets/ai-observability.env -p global -f docker-compose.yml -f infra/ai-observability.compose.yml --profile ai-observability up -d",
    "infra:ai-observability:stop": "docker compose --env-file .secrets/ai-observability.env -p global -f docker-compose.yml -f infra/ai-observability.compose.yml --profile ai-observability stop",
    "infra:up:legacy": "docker compose -p global-backend up -d",
    "infra:down:legacy": "docker compose -p global-backend down",
    "worktree:new": "node scripts/create-codex-worktree.mjs",
    "worktree:inventory": "node scripts/worktree-inventory.mjs",
    "docs:verify": "pnpm governance:verify && node --test scripts/model-candidate-baseline.spec.mjs && pnpm --filter @global/contracts build && pnpm exec tsx --test scripts/verify-model-candidate-registry.spec.mts && node scripts/verify-docs.mjs",
    "governance:test": "node --test scripts/governance-contracts.spec.mjs scripts/governance-path-contracts.spec.mjs",
    "governance:verify": "pnpm governance:test && node scripts/governance-verify.mjs verify",
    "governance:providers": "node scripts/governance-verify.mjs generate-provider-doc",
    "governance:release": "node scripts/governance-verify.mjs render-release",
    "docs:model-candidates": "node scripts/generate-model-candidate-baseline.mjs",
    "memoryctl": "node scripts/memoryctl.mjs",
    "memory:test": "node --test scripts/memoryctl.spec.mjs",
    "decision-card:test": "node --test scripts/pr-decision-card.spec.mjs",
    "code-intelligence:scan": "pnpm --filter @global/code-intelligence scan",
    "code-intelligence:check": "pnpm --filter @global/code-intelligence check",
    "code-intelligence:test": "pnpm --filter @global/code-intelligence test",
    "code-intelligence:codegraph:index-active": "pnpm --filter @global/code-intelligence codegraph:index:active",
    "code-intelligence:codegraph:index-main": "pnpm --filter @global/code-intelligence codegraph:index:main",
    "code-intelligence:codegraph:status-active": "pnpm --filter @global/code-intelligence codegraph:status:active",
    "code-intelligence:codegraph:status-main": "pnpm --filter @global/code-intelligence codegraph:status:main",
    "code-intelligence:codegraph:evaluate": "pnpm --filter @global/code-intelligence codegraph:evaluate",
    "code-intelligence:runtime:capture": "pnpm --filter @global/code-intelligence runtime:capture",
    "code-intelligence:runtime:status": "pnpm --filter @global/code-intelligence runtime:status",
    "code-intelligence:runtime:diff": "pnpm --filter @global/code-intelligence runtime:diff",
    "contracts:lint": "pnpm --filter @global/contracts lint",
    "contracts:docs": "pnpm --filter @global/contracts docs",
    "contracts:mock": "pnpm --filter @global/contracts mock",
    "contracts:gen": "pnpm --filter @global/contracts gen",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nx": "^23.1.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
