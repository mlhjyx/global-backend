{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "golden-sampling-manifest/v1",
  "title": "Golden discovery sampling manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "goldenSet", "seed", "datasets"],
  "properties": {
    "schemaVersion": { "const": "golden-sampling-manifest/v1" },
    "goldenSet": { "type": "string", "pattern": "^golden-discovery/" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "seed": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "SAMPLING", "LABELING", "IN_REVIEW", "PUBLISHED", "SUPERSEDED", "RETIRED"] },
    "layers": { "type": "object" },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key", "purpose", "quota"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "purpose": { "type": "string", "minLength": 1 },
          "totalQuota": { "type": "integer", "minimum": 1 },
          "quota": {
            "type": "object",
            "required": ["anchor", "rolling", "challenge"],
            "properties": {
              "anchor": { "type": "integer", "minimum": 0 },
              "rolling": { "type": "integer", "minimum": 0 },
              "challenge": { "type": "integer", "minimum": 0 }
            }
          },
          "strata": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "stratumComposition": { "type": "string" }
        }
      }
    },
    "refsSha256": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
