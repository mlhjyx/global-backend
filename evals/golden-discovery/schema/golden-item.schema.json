{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "golden-item/v1",
  "title": "Golden discovery item (account or contact; PII-free references only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "dataset", "layer", "stratum", "subject", "labels"],
  "properties": {
    "schemaVersion": { "const": "golden-item/v1" },
    "id": { "type": "string", "pattern": "^(acct|contact)-[0-9]{4}$" },
    "dataset": { "enum": ["accounts", "contacts_strict", "contacts_plus"] },
    "layer": { "enum": ["anchor", "rolling", "challenge"] },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country"],
      "properties": {
        "country": { "type": "string" },
        "industry": { "type": "string" },
        "employeeBand": { "type": "string" },
        "sourceClass": { "type": "string" },
        "seniority": { "type": "string" },
        "channel": { "enum": ["email", "phone", "both", "unknown"] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "description": "canonical_company.id or blind contact dedupe_key (HMAC) — never plaintext PII" },
        "name": { "type": "string", "description": "company legal/trading name (public business fact)" },
        "domain": { "type": "string" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "subjectAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "icpRef": { "type": "string" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_company": { "enum": ["yes", "no", "ambiguous"] },
        "in_icp": { "enum": ["match", "weak", "mismatch", "unknown"] },
        "country": { "type": "string" },
        "industry": { "type": "string" },
        "employee_band": { "type": "string" },
        "domain_correct": { "enum": ["yes", "no", "not_applicable"] },
        "is_competitor": { "enum": ["yes", "no"] },
        "person_exists": { "enum": ["yes", "no", "ambiguous"] },
        "is_decision_maker": { "enum": ["yes", "no", "unknown"] },
        "email_status_truth": { "enum": ["valid", "invalid", "catch_all", "unknown"] },
        "email_is_personal": { "enum": ["yes", "no"] },
        "phone_status_truth": { "enum": ["valid", "invalid", "unknown"] },
        "source_correct": { "enum": ["yes", "no"] },
        "lawful_basis_ok": { "enum": ["yes", "no"] },
        "evidence_url": { "type": "string", "pattern": "^https://" }
      }
    },
    "notes": { "type": "string" }
  }
}
