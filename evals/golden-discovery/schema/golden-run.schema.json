{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "golden-run/v1",
  "title": "Golden annotation run (batch-level record) or evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "goldenSet", "version", "asOf", "sampleSha256", "metrics"],
  "properties": {
    "schemaVersion": { "const": "golden-run/v1" },
    "kind": { "enum": ["annotation", "evaluation"] },
    "goldenSet": { "type": "string", "pattern": "^golden-discovery/" },
    "version": { "type": "integer", "minimum": 1 },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sampleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "annotators": { "type": "array", "items": { "type": "string" } },
    "sampleN": { "type": "integer", "minimum": 1 },
    "doubleLabeledN": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "object",
      "description": "kappa per field, raw agreement, precision/recall, dispute rate, durations…",
      "minProperties": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ok"],
        "properties": {
          "name": { "type": "string" },
          "ok": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "pipelineRef": { "type": "string", "description": "commit + model/prompt/verifier versions for evaluation runs" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "notes": { "type": "string" }
  }
}
