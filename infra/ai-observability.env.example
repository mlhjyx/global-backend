# Copy to `.secrets/ai-observability.env`, generate every secret locally, and
# keep the resulting file outside Git. Langfuse release verified 2026-08-04.
LANGFUSE_IMAGE_TAG=4.3.1
# Must remain URL-safe because Langfuse consumes it in DATABASE_URL. Generate
# exactly 64 lowercase hexadecimal characters with `openssl rand -hex 32`.
LANGFUSE_POSTGRES_PASSWORD=replace-with-64-lowercase-hex
LANGFUSE_REDIS_PASSWORD=replace-with-random-value
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-random-value
LANGFUSE_MINIO_ACCESS_KEY=replace-with-random-value
LANGFUSE_MINIO_SECRET_KEY=replace-with-random-value
LANGFUSE_SALT=replace-with-random-value
# Exactly 64 lowercase hexadecimal characters (`openssl rand -hex 32`).
LANGFUSE_ENCRYPTION_KEY=CHANGEME
LANGFUSE_NEXTAUTH_SECRET=replace-with-random-value

LANGFUSE_INIT_ORG_ID=global-dev
LANGFUSE_INIT_ORG_NAME="Global Development"
LANGFUSE_INIT_PROJECT_ID=model-runtime
LANGFUSE_INIT_PROJECT_NAME="Model Runtime"
# These are both the headless-init credentials and the application exporter
# credentials. Preserve the required Langfuse prefixes.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-random-suffix
LANGFUSE_SECRET_KEY=sk-lf-replace-with-random-suffix
LANGFUSE_BASE_URL=http://127.0.0.1:3002
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_ALLOW_REMOTE_EXPORT=false
LANGFUSE_INIT_USER_EMAIL=replace-with-local-admin-email
LANGFUSE_INIT_USER_NAME="Local Admin"
LANGFUSE_INIT_USER_PASSWORD=replace-with-random-value
