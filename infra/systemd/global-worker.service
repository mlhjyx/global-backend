[Unit]
Description=Global backend Temporal Worker (immutable OCI managed runtime)
Documentation=https://github.com/mlhjyx/global-backend
After=network-online.target docker.service temporal-dev.service
Wants=network-online.target
Requires=docker.service temporal-dev.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/global/backend
EnvironmentFile=/global/backend/.secrets/backend-runtime.env
ExecStartPre=/usr/bin/docker compose --env-file /global/backend/.secrets/minio-bootstrap.env --env-file /global/backend/.secrets/backend-runtime.env -p global -f docker-compose.yml -f infra/backend-runtime.compose.yml --profile managed-runtime config --quiet
ExecStart=/usr/bin/docker compose --env-file /global/backend/.secrets/minio-bootstrap.env --env-file /global/backend/.secrets/backend-runtime.env -p global -f docker-compose.yml -f infra/backend-runtime.compose.yml --profile managed-runtime up worker
ExecStop=/usr/bin/docker compose --env-file /global/backend/.secrets/minio-bootstrap.env --env-file /global/backend/.secrets/backend-runtime.env -p global -f docker-compose.yml -f infra/backend-runtime.compose.yml --profile managed-runtime stop worker
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=global-worker

[Install]
WantedBy=multi-user.target
