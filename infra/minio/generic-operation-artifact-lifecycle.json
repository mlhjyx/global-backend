      "NoncurrentVersionExpiration": { "NoncurrentDays": 1 },
      "ID": "generic-operation-artifact-readiness-cleanup",
      "Status": "Enabled",
      "Filter": { "Prefix": "generic-operation-results/v1/readiness/" }
