# Prisma CLI（migrate / generate / studio）读取本文件。复制为 packages/db/.env 后按本机口令修改。
# 本机工作区里新建的 worktree 用 `gctl link-env <worktree>` 链接根 checkout 的真实 .env，无需复制。
#
# owner：绕过 RLS，供迁移与 seed 使用
DATABASE_URL=postgresql://global:global@localhost:5432/global_dev
# app_user：走 RLS 的应用身份；在单测进程中可见时，PostgreSQL JSONB 字节门用例会连库
APP_DATABASE_URL=postgresql://app_user:app_pw@localhost:5432/global_dev
