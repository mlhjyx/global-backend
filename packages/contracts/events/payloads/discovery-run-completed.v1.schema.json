{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.global/events/payloads/discovery-run-completed.v1.schema.json",
  "title": "DiscoveryRunCompletedV1",
  "description": "DiscoveryRunCompleted uses envelope v1 for both execution contracts. Historical payloads may omit taskRef, stats, cost, and costBasis. Execution contract v3 adds the verified origin and, for SaaS tasks, the verified task binding.",
  "type": "object",
  "additionalProperties": true,
  "required": ["status"],
  "properties": {
    "planId": { "type": "string" },
    "status": { "type": "string", "enum": ["DONE", "PARTIAL", "FAILED", "CANCELLED"] },
    "stats": { "type": "object", "additionalProperties": true },
    "cost": { "type": "number" },
    "costBasis": { "type": "string" },
    "taskRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "taskId": { "type": "string", "format": "uuid" },
        "taskRunId": { "type": "string", "format": "uuid" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["executionContractVersion"] },
          { "required": ["executionOrigin"] },
          { "required": ["icpId"] },
          {
            "required": ["taskRef"],
            "properties": {
              "taskRef": {
                "type": "object",
                "anyOf": [
                  { "required": ["workspaceId"] },
                  { "required": ["planId"] },
                  { "required": ["attemptId"] },
                  { "required": ["requestSha256"] }
                ]
              }
            }
          }
        ]
      },
      "then": {
        "required": ["executionContractVersion", "executionOrigin", "planId", "icpId"],
        "properties": {
          "executionContractVersion": { "const": 3 },
          "executionOrigin": { "enum": ["DIRECT", "SAAS_TASK"] },
          "planId": { "$ref": "#/$defs/executionUuid" },
          "icpId": { "$ref": "#/$defs/executionUuid" },
          "runId": { "$ref": "#/$defs/executionUuid" },
          "run_id": { "$ref": "#/$defs/executionUuid" },
          "cost": { "minimum": 0 },
          "costBasis": { "maxLength": 64 },
          "taskRef": { "$ref": "#/$defs/discoveryTaskRefV3" }
        },
        "not": { "required": ["cost_usd"] },
        "oneOf": [
          { "properties": { "executionOrigin": { "const": "SAAS_TASK" } }, "required": ["taskRef"] },
          { "properties": { "executionOrigin": { "const": "DIRECT" } }, "not": { "required": ["taskRef"] } }
        ]
      }
    }
  ],
  "$defs": {
    "executionUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "discoveryTaskRefV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "taskId", "taskRunId", "planId", "attemptId", "requestSha256"],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/executionUuid" },
        "taskId": { "$ref": "#/$defs/executionUuid" },
        "taskRunId": { "$ref": "#/$defs/executionUuid" },
        "planId": { "$ref": "#/$defs/executionUuid" },
        "attemptId": { "$ref": "#/$defs/executionUuid" },
        "requestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
