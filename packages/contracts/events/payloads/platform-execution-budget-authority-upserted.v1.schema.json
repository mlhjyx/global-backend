{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.global/events/payloads/platform-execution-budget-authority-upserted.v1.schema.json",
  "title": "PlatformExecutionBudgetAuthorityUpsertedV1",
  "description": "Closed claims contract carried inside the signed compact JWS registered externally as PlatformExecutionBudgetAuthorityUpserted/v1. This is not an outbound DomainEventEnvelope and does not describe an outer transport wrapper.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iss",
    "aud",
    "jti",
    "iat",
    "nbf",
    "exp",
    "authority_kind",
    "purpose",
    "subject_type",
    "subject_id",
    "schedule_id",
    "schedule_request_sha256",
    "workflow_id",
    "workflow_run_id",
    "technical_policy_revision",
    "currency",
    "unit",
    "cap_per_run_microusd",
    "campaign_cap_microusd",
    "max_runs"
  ],
  "properties": {
    "schema_version": { "const": "execution-budget-grant/v1" },
    "iss": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 512
    },
    "aud": { "const": "global-backend:execution-budget" },
    "jti": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "iat": { "$ref": "#/$defs/numericDate" },
    "nbf": { "$ref": "#/$defs/numericDate" },
    "exp": { "$ref": "#/$defs/numericDate" },
    "authority_kind": { "const": "PLATFORM_GRANT" },
    "purpose": {
      "enum": [
        "platform.acquisition",
        "platform.intent_watch",
        "platform.sanctions"
      ]
    },
    "subject_type": { "const": "schedule" },
    "subject_id": { "$ref": "#/$defs/boundedIdentifier" },
    "schedule_id": {
      "$ref": "#/$defs/boundedIdentifier",
      "description": "Must equal subject_id; equality is enforced after signature verification."
    },
    "schedule_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "workflow_run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "technical_policy_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "currency": { "const": "USD" },
    "unit": { "const": "microusd" },
    "cap_per_run_microusd": { "$ref": "#/$defs/positiveDecimal" },
    "campaign_cap_microusd": {
      "$ref": "#/$defs/positiveDecimal",
      "description": "Must equal cap_per_run_microusd; equality is enforced after signature verification."
    },
    "max_runs": { "const": "1" }
  },
  "$defs": {
    "numericDate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "boundedIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,190}$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19,
      "description": "Canonical positive decimal within PostgreSQL BIGINT; the verifier enforces the exact 9223372036854775807 upper bound."
    }
  }
}
