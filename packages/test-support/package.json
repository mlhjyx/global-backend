{
  "name": "@global/test-support",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/sandbox.provider.d.ts",
