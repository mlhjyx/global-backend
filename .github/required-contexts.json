    "owner": "@mlhjyx",
    "terminal_patterns": [
      "/.github/",
      "/.gitleaks.toml",
      "/.gitleaksignore",
      "/AGENTS.md",
      "/apps/api/src/discovery/provider-source-classes.json",
      "/apps/api/src/runtime/",
      "/apps/api/scripts/generate-build-attestation.mts",
      "/docs/status/",
      "/docs/governance/",
      "/docs/backend/ci-merge-automation.md",
      "/docs/backend/provider-registry.md",
      "/docs/evidence/README.md",
      "/docs/evidence/runtime/",
      "/docs/evidence/site-builder/copy-runtime-eligibility.json",
      "/docs/implementation-records/copy-fixed-source-impact-governance.md",
      "/docs/security/",
      "/docs/releases/",
      "/docs/templates/release-bundle.template.json",
      "/package.json",
