{
  "schema_version": "required-contexts/v1",
  "required_contexts": [
    "renderer visual scope",
    "build · typecheck · test",
    "contracts · drift · lint · breaking",
    "gitleaks 密钥扫描",
    "governance · traceability · release",
    "nontechnical decision card freshness"
  ],
  "context_implementations": [
    {
      "name": "renderer visual scope",
      "workflow": ".github/workflows/ci.yml",
      "event": "pull_request"
    },
    {
      "name": "build · typecheck · test",
      "workflow": ".github/workflows/ci.yml",
      "event": "pull_request",
      "allowed_job_if": "always()"
    },
    {
      "name": "contracts · drift · lint · breaking",
      "workflow": ".github/workflows/ci.yml",
      "event": "pull_request"
    },
    {
      "name": "gitleaks 密钥扫描",
      "workflow": ".github/workflows/security.yml",
      "event": "pull_request"
    },
    {
      "name": "governance · traceability · release",
      "workflow": ".github/workflows/governance.yml",
      "event": "pull_request"
    },
    {
      "name": "nontechnical decision card freshness",
      "workflow": ".github/workflows/pr-decision-card.yml",
      "event": "pull_request_target",
      "allowed_job_if": "github.event.pull_request.base.ref == github.event.repository.default_branch"
    }
  ],
  "workflow_runtime_requirements": [
    { "workflow": ".github/workflows/ci.yml", "node_major": 22 },
