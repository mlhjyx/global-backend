      "/**/.npmrc",
      "/.pnpmfile.cjs",
      "/**/.pnpmfile.cjs",
      "/patches/",
      "/scripts/governance-*.mjs",
      "/scripts/copy-fixed-source-impact*.mjs",
      "/scripts/pr-decision-card*.mjs",
