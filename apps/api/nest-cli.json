{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "platform-authority/platform-authority-policy-*.json",
        "outDir": "dist"
      },
      {
        "include": "skills/packs/schemas/*.schema.json",
        "outDir": "dist"
      }
    ]
  }
}
