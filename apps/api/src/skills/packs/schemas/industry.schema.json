{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "industry.schema.json",
  "title": "Industry pack v1",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "packType": {
          "const": "industry"
        },
        "priorityClass": {
          "enum": [
            "industry"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "taxonomy",
              "buyerRoles",
              "terminology",
              "regulations"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "taxonomy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scheme",
                  "codes"
                ],
                "properties": {
                  "scheme": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "codes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              },
              "buyerRoles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "terminology": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "regulations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "jurisdiction",
                    "note"
                  ],
                  "properties": {
                    "jurisdiction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "packType",
        "priorityClass",
        "rules"
      ]
    }
  ]
}
