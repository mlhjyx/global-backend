{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Skill pack envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packKey",
    "packType",
    "version",
    "title",
    "description",
    "priorityClass",
    "owner",
    "license",
    "rules",
    "sources",
    "exitPlan"
  ],
  "properties": {
    "packKey": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)+$"
    },
    "packType": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "priorityClass": { "type": "string" },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "industries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "markets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "motions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "notice": { "type": "string", "maxLength": 2000 },
    "contentPath": { "type": "string", "const": "PACK.md" },
    "rules": { "type": "array" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 300 },
          "url": { "type": "string", "pattern": "^https?://", "maxLength": 500 },
          "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "exitPlan": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
