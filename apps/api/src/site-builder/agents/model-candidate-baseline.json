  "evaluationPolicy": {
    "ordering": [
      "quality",
      "structure",
      "factuality",
      "stability",
      "p95_latency",
      "accepted_artifact_cost"
    ],
    "taskWindow": "production_task_envelope",
    "diagnosticWindow": "extended_observation_after_runtime_envelope",
    "qualityValidLateClass": "quality_valid_runtime_late",
    "contentInvalidClass": "content_invalid",
    "absoluteStop": "pre_dispatch_campaign_budget_plus_per_call_cap",
    "promotionRule": "No baseline entry routes traffic; promotion remains a separate per-task evidence and approval PR."
  },
  "followUpPrs": [
    {
      "order": 2,
      "name": "capability-and-task-evaluation-harness",
      "output": "Protocol, capability, task-envelope, diagnostic-window, and closed-result harness only."
    },
    {
      "order": 3,
      "name": "fixed-commit-real-evidence",
      "output": "Create-only evidence from a fixed commit with complete provenance and conservative cost settlement."
    },
    {
      "order": 4,
      "name": "per-task-promotion",
      "output": "One task at a time, with explicit owner approval, failure gates, rollback, and no automatic merge."
    }
