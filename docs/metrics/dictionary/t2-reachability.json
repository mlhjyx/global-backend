{
  "schemaVersion": "metric-dictionary/v1",
  "tier": "T2",
  "metrics": [
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-001",
      "name": "email_coverage_rate",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "match 账户中拥有 ≥1 个 email 类型联系点（任意状态）的比例；与 email_valid_rate 分母不同，禁止混用。2026-11-09：全库 73/403=18.1%（Wilson 95% CI [14.7%, 22.2%]）；主租户 9/128=7.0%。",
      "numerator": { "expr": "count(distinct canonical_company.id) filter (where exists(email contact_point))", "source": "contact_point" },
      "denominator": { "expr": "count(distinct canonical_company.id) filter (where lead.fit_verdict='match')", "source": "lead" },
      "exclusions": ["仅公司通道（company_contact_channel）不算「有联系人邮箱」", "测试租户与主租户并列报告"],
      "window": { "type": "rolling", "days": 7 },
      "strata": ["country", "industry", "source_class", "provider_key", "workspace_id"],
      "ci": { "method": "wilson" },
      "benchmark": { "note": "对 ICP 账户 email fill 80%+（瀑布 85–95%）", "url": "https://www.clay.com/guides/waterfall-enrichment" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义；明确独立于 email_valid_rate" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-002",
      "name": "email_valid_rate",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "已尝试验证的邮箱中判定为 VALID（且非 catch-all）的比例；分母只含已裁决四态的地址。2026-11-09：0/274（全部 RISKY/UNVERIFIED/INVALID，无一条邮箱级验证）。",
      "numerator": { "expr": "count(distinct email_hash) filter (where status='VALID' and catch_all='not_catch_all')", "source": "contact_point" },
      "denominator": { "expr": "count(distinct email_hash) filter (where status in ('VALID','INVALID','RISKY','UNVERIFIED') and verdict_recorded)", "source": "contact_point" },
      "exclusions": ["role 邮箱出分子留分母", "同邮箱 7 天内重复验证按最新裁决去重", "bounce 回写视为 INVALID 且优先于验证器"],
      "window": { "type": "rolling", "days": 30 },
      "strata": ["country", "source_class", "provider_key", "verifier", "workspace_id"],
      "ci": { "method": "wilson" },
      "benchmark": { "note": "导出后 valid 70–85%；catch-all 10–30%", "url": "https://bouncezero.io/b2b-contact-database-provider" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义；分母从「有邮箱」改为「已尝试验证」" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-003",
      "name": "catch_all_rate",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "已尝试验证邮箱中 CATCH-ALL-RISKY 的比例；当前不可测（0 条邮箱级裁决，0 不代表没有 catch-all）。",
      "numerator": { "expr": "count(distinct email_hash) filter (where catch_all in ('catch_all','catch_all_risky'))", "source": "contact_point" },
      "denominator": { "expr": "count(distinct email_hash) filter (where verdict_recorded)", "source": "contact_point" },
      "exclusions": ["未验证地址不进分母"],
      "window": { "type": "rolling", "days": 30 },
      "strata": ["country", "verifier", "provider_key", "workspace_id"],
      "ci": { "method": "wilson" },
      "benchmark": { "note": "10–30% 为常态", "url": "https://bouncezero.io/catch-all-email-study-2026" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-004",
      "name": "unknown_rate",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "已尝试验证邮箱中 UNKNOWN 的比例；越低越好。",
      "numerator": { "expr": "count(distinct email_hash) filter (where verdict='UNKNOWN')", "source": "contact_point" },
      "denominator": { "expr": "count(distinct email_hash) filter (where verdict_recorded)", "source": "contact_point" },
      "exclusions": ["未验证地址不进分母"],
      "window": { "type": "rolling", "days": 30 },
      "strata": ["country", "verifier", "provider_key", "workspace_id"],
      "ci": { "method": "wilson" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-005",
      "name": "phone_fill_rate",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "match 账户中拥有人级 phone 联系点的比例。2026-11-09：全库 4/403=1.0%；主租户 0。",
      "numerator": { "expr": "count(distinct canonical_company.id) filter (where exists(phone contact_point))", "source": "contact_point" },
      "denominator": { "expr": "count(distinct canonical_company.id) filter (where lead.fit_verdict='match')", "source": "lead" },
      "exclusions": ["公司总机不算（人级 phone 才计入）", "LinkedIn URL 不算"],
      "window": { "type": "rolling", "days": 7 },
      "strata": ["country", "source_class", "provider_key", "workspace_id"],
      "ci": { "method": "wilson" },
      "benchmark": { "note": "phone fill 40–65%", "url": "https://www.explorium.ai/blog/data-for-gtm/b2b-data-api-match-rate-benchmarks/" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-006",
      "name": "phone_connect_rate",
      "tier": "T2",
      "unit": "ratio",
      "owner": "gtm-ops",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "人工抽呼接通率（每季度每市场 50–100 通）；空号/错号单列。",
      "numerator": { "expr": "count(*) filter (where connected)", "source": "contact_point" },
      "denominator": { "expr": "count(*) filter (where dialed)", "source": "contact_point" },
      "exclusions": ["测试拨号与内部号码剔除"],
      "window": { "type": "cohort", "days": 90 },
      "strata": ["country", "provider_key", "workspace_id"],
      "ci": { "method": "wilson" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-007",
      "name": "contact_role_coverage",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "match 账户中至少有一个决策人角色联系人的比例（seniority ∈ c_level/vp/director/manager 或 title 命中词表）。",
      "numerator": { "expr": "count(distinct canonical_company.id) filter (where exists(decision-maker canonical_contact))", "source": "canonical_contact" },
      "denominator": { "expr": "count(distinct canonical_company.id) filter (where lead.fit_verdict='match')", "source": "lead" },
      "exclusions": ["角色未知不算", "职能邮箱联系人不可单独构成覆盖"],
      "window": { "type": "rolling", "days": 7 },
      "strata": ["country", "source_class", "persona_role", "workspace_id"],
      "ci": { "method": "wilson" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-008",
      "name": "contacts_per_matched_account",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "match 账户的人均联系人数量（去重）。",
      "numerator": { "expr": "count(distinct canonical_contact.id)", "source": "canonical_contact" },
      "denominator": { "expr": "count(distinct canonical_company.id) filter (where lead.fit_verdict='match')", "source": "lead" },
      "exclusions": ["按人级 dedupe_key 去重", "匿名/无姓名联系人不计"],
      "window": { "type": "rolling", "days": 7 },
      "strata": ["country", "source_class", "workspace_id"],
      "ci": { "method": "bootstrap" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-009",
      "name": "verification_freshness_ratio",
      "tier": "T2",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "已验证联系点中在 90/180 天内验证的比例（按通道：email 180 天、phone 90 天）。",
      "numerator": { "expr": "count(*) filter (where verified_at >= now() - channel_freshness_interval)", "source": "contact_point" },
      "denominator": { "expr": "count(*) filter (where status='VALID')", "source": "contact_point" },
      "exclusions": ["未验证点不进分母"],
      "window": { "type": "snapshot", "cadence": "weekly" },
      "strata": ["country", "channel", "verifier", "workspace_id"],
      "ci": { "method": "wilson" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T2-010",
      "name": "cost_per_valid_contact",
      "tier": "T2",
      "unit": "usd",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "definition": "富化+验证+人工成本（tool_budget_operation 实扣口径，含失败成本）除以 VALID 联系人数；目标 ≤$0.80。",
      "numerator": { "expr": "sum(charged_microusd) / 1e6", "source": "tool_budget_operation" },
      "denominator": { "expr": "count(distinct contact_point.id) filter (where status='VALID')", "source": "contact_point" },
      "exclusions": ["含失败成本（不摊薄）", "人力成本按内部工时另计"],
      "window": { "type": "rolling", "days": 30 },
      "strata": ["provider_key", "verifier", "workspace_id"],
      "ci": { "method": "bootstrap" },
      "changelog": [{ "version": 1, "at": "2026-11-09", "breaking": false, "note": "首次定义" }]
    }
  ]
}
