{
  "schemaVersion": "metric-dictionary/v1",
  "tier": "GUARDRAIL",
  "metrics": [
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-001",
      "name": "bounce_rate_hard",
      "tier": "GUARDRAIL",
      "unit": "ratio",
      "owner": "gtm-ops",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "hard bounces 占 delivered+sent；软退信连续 3 次按硬退。P4 接线前只做口径与采集就绪，不产生告警。",
      "numerator": {
        "expr": "count(*) filter (where hard_bounce)",
        "source": "outreach_send"
      },
      "denominator": {
        "expr": "count(*) filter (where delivered or sent)",
        "source": "outreach_send"
      },
      "exclusions": [
        "软退信连续 3 次按硬退",
        "测试发送剔除"
      ],
      "window": {
        "type": "rolling",
        "days": 7
      },
      "strata": [
        "country",
        "provider_key",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "benchmark": {
        "note": "<2% 目标；≥5% 停发（AWS SES）",
        "url": "https://docs.aws.amazon.com/ses/latest/dg/faqs-enforcement.html"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义（P4 前 DRAFT，不告警）"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-002",
      "name": "spam_complaint_rate",
      "tier": "GUARDRAIL",
      "unit": "ratio",
      "owner": "gtm-ops",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "投诉数占 delivered；Gmail <0.1% 目标、0.3% 硬线；SES 0.1% 审查、0.5% 可能暂停。",
      "numerator": {
        "expr": "count(*) filter (where complaint)",
        "source": "outreach_send"
      },
      "denominator": {
        "expr": "count(*) filter (where delivered)",
        "source": "outreach_send"
      },
      "exclusions": [
        "测试发送剔除"
      ],
      "window": {
        "type": "rolling",
        "days": 7
      },
      "strata": [
        "country",
        "provider_key",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "benchmark": {
        "note": "<0.1%；0.3% 硬线",
        "url": "https://support.google.com/mail/answer/14229414"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义（P4 前 DRAFT，不告警）"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-003",
      "name": "suppression_hit_rate",
      "tier": "GUARDRAIL",
      "unit": "ratio",
      "owner": "backend",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "被 suppression 拦截的发送占命中 suppression 名单的比例；必须 100%。",
      "numerator": {
        "expr": "count(*) filter (where blocked_by_suppression)",
        "source": "outreach_send"
      },
      "denominator": {
        "expr": "count(*) filter (where suppression_match)",
        "source": "outreach_send"
      },
      "exclusions": [
        "任何应拦未拦按 P0 事故处理"
      ],
      "window": {
        "type": "rolling",
        "days": 1
      },
      "strata": [
        "workspace_id"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义；必须 100%"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-004",
      "name": "judge_human_agreement",
      "tier": "GUARDRAIL",
      "unit": "kappa",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "LLM judge 与人工标注的一致率（Cohen's κ），按任务分层；κ≥0.6 目标 0.8。",
      "numerator": {
        "expr": "cohen_kappa(judge_label, human_label)",
        "source": "golden_label"
      },
      "denominator": {
        "expr": "count(*) where both labels present",
        "source": "golden_label"
      },
      "exclusions": [
        "与每位标注者分别比较，不混池",
        "类别不平衡时同时报 raw agreement"
      ],
      "window": {
        "type": "cohort",
        "days": 30
      },
      "strata": [
        "task",
        "field",
        "workspace_id"
      ],
      "ci": {
        "method": "bootstrap"
      },
      "benchmark": {
        "note": "κ≥0.6 才发布该字段金标",
        "url": "https://doi.org/10.2307/2529310"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-005",
      "name": "annotation_kappa",
      "tier": "GUARDRAIL",
      "unit": "kappa",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "双人独立标注的逐字段一致率（Cohen's κ）；κ<0.6 先修 rubric/培训/缩字段。",
      "numerator": {
        "expr": "cohen_kappa(annotator_a, annotator_b)",
        "source": "golden_label"
      },
      "denominator": {
        "expr": "count(*) where both annotators present",
        "source": "golden_label"
      },
      "exclusions": [
        "不得用多数投票硬凑",
        "κ 高但 raw 低需解释（类别不平衡）"
      ],
      "window": {
        "type": "cohort",
        "days": 30
      },
      "strata": [
        "field",
        "task",
        "workspace_id"
      ],
      "ci": {
        "method": "bootstrap"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-006",
      "name": "psi_drift",
      "tier": "GUARDRAIL",
      "unit": "index",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "Population Stability Index（固定 10 个等频箱）；0.1 关注、0.25 告警（经验阈值需按样本量校准）。",
      "numerator": {
        "expr": "psi(baseline_bins, current_bins)",
        "source": "metric_observation"
      },
      "denominator": null,
      "exclusions": [
        "分箱固定，不随数据重算",
        "大样本需重新校准阈值"
      ],
      "window": {
        "type": "rolling",
        "days": 7
      },
      "strata": [
        "country",
        "industry",
        "source_class",
        "workspace_id"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-007",
      "name": "metric_freshness_hours",
      "tier": "GUARDRAIL",
      "unit": "hours",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "now 减去最新 metric observation 的时刻；>26h 触发 METRIC_STALE。",
      "numerator": {
        "expr": "now() - max(computed_at)",
        "source": "metric_observation"
      },
      "denominator": null,
      "exclusions": [
        "不含未接线的指标"
      ],
      "window": {
        "type": "snapshot",
        "cadence": "daily"
      },
      "strata": [
        "workspace_id"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-008",
      "name": "event_backlog_seconds",
      "tier": "GUARDRAIL",
      "unit": "seconds",
      "owner": "backend",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "now 减去最老未消费 outbox 事件的时刻；>900s 触发 EVENT_BACKLOG。",
      "numerator": {
        "expr": "now() - min(occurred_at) filter (where not consumed)",
        "source": "outbox_event"
      },
      "denominator": null,
      "exclusions": [
        "按事件类型分层"
      ],
      "window": {
        "type": "snapshot",
        "cadence": "daily"
      },
      "strata": [
        "workspace_id"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-009",
      "name": "bounce_rate_total",
      "tier": "GUARDRAIL",
      "unit": "ratio",
      "owner": "gtm-ops",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "hard+soft bounces 占 delivered+sent 的比例（辅助 G-001，报告用）。",
      "numerator": {
        "expr": "count(*) filter (where hard_bounce or soft_bounce)",
        "source": "outreach_send"
      },
      "denominator": {
        "expr": "count(*) filter (where delivered or sent)",
        "source": "outreach_send"
      },
      "exclusions": [
        "测试发送剔除"
      ],
      "window": {
        "type": "rolling",
        "days": 7
      },
      "strata": [
        "country",
        "provider_key",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "G-010",
      "name": "golden_gate_status",
      "tier": "GUARDRAIL",
      "unit": "status",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "最近一次 golden_eval_run 的 gates 全绿=GREEN、任一红=RED；红即阻断发布。",
      "numerator": {
        "expr": "case when all(gate.ok) then 'GREEN' else 'RED' end",
        "source": "golden_eval_run"
      },
      "denominator": null,
      "exclusions": [
        "ERROR（环境错误）单列，不算质量结论"
      ],
      "window": {
        "type": "snapshot",
        "cadence": "daily"
      },
      "strata": [
        "workspace_id"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    }
  ]
}
