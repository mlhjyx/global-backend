{
  "schemaVersion": "metric-dictionary/v1",
  "tier": "T1",
  "metrics": [
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-001",
      "name": "universe_estimate_n",
      "tier": "T1",
      "unit": "count",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "capture-recapture 模型估计的市场实体总量 N̂（含区间与 CV）；两源仅作 sanity check，三源起用 log-linear/LCMCR。",
      "numerator": {
        "expr": "n_hat from cr_estimate",
        "source": "cr_estimate"
      },
      "denominator": null,
      "exclusions": [
        "两两交集 <5 不报 N̂",
        "模型间跨度 >30% 只报范围",
        "不用于月度硬考核"
      ],
      "window": {
        "type": "cohort",
        "days": 90
      },
      "strata": [
        "country",
        "industry",
        "employee_band",
        "source_class",
        "frame_key",
        "workspace_id"
      ],
      "ci": {
        "method": "bootstrap"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义；实现脚手架见 scripts/metrics/capture-recapture.mjs（三源 log-linear + bootstrap）"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-002",
      "name": "company_recall_vs_frame",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "frame 分层抽样中被我们发现的实体数占抽样实体数的比例（路径 A：有完整注册库）。",
      "numerator": {
        "expr": "count(*) filter (where found) from frame_sample",
        "source": "frame_snapshot"
      },
      "denominator": {
        "expr": "count(*) from frame_sample",
        "source": "frame_snapshot"
      },
      "exclusions": [
        "已关闭/非 ICP 先剔除",
        "无 frame 快照的 stratum 不出数"
      ],
      "window": {
        "type": "cohort",
        "days": 30
      },
      "strata": [
        "country",
        "industry",
        "employee_band",
        "frame_key",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-003",
      "name": "company_recall_vs_estimate",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "我们发现的唯一实体数除以 N̂（路径 B：无完整注册库时对估计总量的覆盖）。",
      "numerator": {
        "expr": "count(distinct canonical_company.id)",
        "source": "canonical_company"
      },
      "denominator": {
        "expr": "n_hat from cr_estimate",
        "source": "cr_estimate"
      },
      "exclusions": [
        "N̂ 不可报告时本指标不出数"
      ],
      "window": {
        "type": "cohort",
        "days": 90
      },
      "strata": [
        "country",
        "industry",
        "workspace_id"
      ],
      "ci": {
        "method": "bootstrap"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-004",
      "name": "domain_resolution_rate",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "有已验证域名的公司数占需解析域名的公司数；当前只能算「domain 非空」的代理值（全库 76.1%），「已验证」依赖 P2 解析流水线。",
      "numerator": {
        "expr": "count(*) filter (where domain is not null and domain_verified)",
        "source": "canonical_company"
      },
      "denominator": {
        "expr": "count(*) filter (where needs_domain)",
        "source": "canonical_company"
      },
      "exclusions": [
        "无官网/仅线下的公司不进分母",
        "目录类源天然无域名，单列"
      ],
      "window": {
        "type": "rolling",
        "days": 30
      },
      "strata": [
        "country",
        "source_class",
        "provider_key",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义（DRAFT：等待 P2 域名解析埋点）"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-005",
      "name": "fit_precision_golden",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "金标集中模型判 match 且人工判 match 的比例（precision）。",
      "numerator": {
        "expr": "count(*) filter (where model_label='match' and human_label='match')",
        "source": "golden_label"
      },
      "denominator": {
        "expr": "count(*) filter (where model_label='match')",
        "source": "golden_label"
      },
      "exclusions": [
        "按层加权汇总，禁止简单平均",
        "n<30 只报区间"
      ],
      "window": {
        "type": "cohort",
        "days": 30
      },
      "strata": [
        "country",
        "industry",
        "employee_band",
        "source_class",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-006",
      "name": "fit_recall_golden",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "金标集中人工判 match 且模型判 match 的比例（recall）。",
      "numerator": {
        "expr": "count(*) filter (where human_label='match' and model_label='match')",
        "source": "golden_label"
      },
      "denominator": {
        "expr": "count(*) filter (where human_label='match')",
        "source": "golden_label"
      },
      "exclusions": [
        "同上：加权与小数样本规则"
      ],
      "window": {
        "type": "cohort",
        "days": 30
      },
      "strata": [
        "country",
        "industry",
        "employee_band",
        "source_class",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-007",
      "name": "source_unique_contribution",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "仅该源贡献（其他源都未捕获）的实体数占该源实体数；用于源降权决策。",
      "numerator": {
        "expr": "count(distinct entity) filter (where only_source = provider_key)",
        "source": "identity_link"
      },
      "denominator": {
        "expr": "count(distinct entity) filter (where provider_key = $provider)",
        "source": "raw_source_record"
      },
      "exclusions": [
        "重复/非 ICP 实体剔除",
        "依赖 P2 帧矩阵的多源归因（当前每公司恰 1 个 provider，近似）"
      ],
      "window": {
        "type": "rolling",
        "days": 30
      },
      "strata": [
        "provider_key",
        "source_class",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-008",
      "name": "source_accept_rate",
      "tier": "T1",
      "unit": "ratio",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "raw 记录中 ingest_status='ACCEPTED' 的比例，按 provider 分层；2026-11-09 全库 4,485/8,148。",
      "numerator": {
        "expr": "count(*) filter (where ingest_status='ACCEPTED')",
        "source": "raw_source_record"
      },
      "denominator": {
        "expr": "count(*)",
        "source": "raw_source_record"
      },
      "exclusions": [
        "按 provider 分层，不做跨源平均"
      ],
      "window": {
        "type": "rolling",
        "days": 7
      },
      "strata": [
        "provider_key",
        "source_class",
        "workspace_id"
      ],
      "ci": {
        "method": "wilson"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义；现状 55.0%（4,485/8,148）"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-009",
      "name": "rejection_reason_distribution",
      "tier": "T1",
      "unit": "distribution",
      "owner": "data-eng",
      "status": "ACTIVE",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "各 disposition_code 的计数分布；分母为带 disposition_code 的记录总数（含 REJECTED 与 QUARANTINED）。2026-11-09：3,663 行有码（2,408 SCHEMA_INVALID / 868 SOURCE_POLICY_MISSING / 387 PROCESSING_KEY_DRIFT）。",
      "numerator": {
        "expr": "count(*) group by disposition_code",
        "source": "raw_source_record"
      },
      "denominator": {
        "expr": "count(*) filter (where disposition_code is not null)",
        "source": "raw_source_record"
      },
      "exclusions": [
        "ACCEPTED 行 disposition_code 为空，不进分母"
      ],
      "window": {
        "type": "rolling",
        "days": 7
      },
      "strata": [
        "provider_key",
        "source_class",
        "workspace_id"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    },
    {
      "schemaVersion": "metric-definition/v1",
      "id": "T1-010",
      "name": "frame_freshness_days",
      "tier": "T1",
      "unit": "days",
      "owner": "data-eng",
      "status": "DRAFT",
      "version": 1,
      "effectiveFrom": "2026-11-09",
      "exprStatus": "PENDING",
      "definition": "asOf 减去 frame 最后成功快照时间；核心 frame >35 天告警。",
      "numerator": {
        "expr": "as_of - last_snapshot_at",
        "source": "frame_registry"
      },
      "denominator": null,
      "exclusions": [
        "QUARANTINED/FAILED 快照不计入新鲜度"
      ],
      "window": {
        "type": "snapshot",
        "cadence": "daily"
      },
      "strata": [
        "frame_key"
      ],
      "ci": {
        "method": "none"
      },
      "changelog": [
        {
          "version": 1,
          "at": "2026-11-09",
          "breaking": false,
          "note": "首次定义"
        }
      ]
    }
  ]
}
