{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metric-definition/v1",
  "title": "GainOS metric definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "tier",
    "unit",
    "owner",
    "status",
    "version",
    "effectiveFrom",
    "definition",
    "numerator",
    "denominator",
    "exclusions",
    "window",
    "strata",
    "ci",
    "changelog"
  ],
  "properties": {
    "schemaVersion": { "const": "metric-definition/v1" },
    "id": { "type": "string", "pattern": "^(T[0-4]|G)-[0-9]{3}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "tier": { "enum": ["T0", "T1", "T2", "T3", "T4", "GUARDRAIL"] },
    "unit": {
      "enum": ["ratio", "count", "count_per_1000", "usd", "usd_per_1000", "days", "hours", "seconds", "kappa", "index", "distribution", "status"]
    },
    "owner": { "enum": ["data-eng", "backend", "gtm-ops", "product"] },
    "status": { "enum": ["ACTIVE", "DRAFT", "DEPRECATED", "RETIRED"] },
    "version": { "type": "integer", "minimum": 1 },
    "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "definition": { "type": "string", "minLength": 10 },
    "numerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expr", "source"],
      "properties": {
        "expr": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "denominator": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expr", "source"],
          "properties": {
            "expr": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["snapshot", "rolling", "cohort"] },
        "days": { "type": "integer", "minimum": 1 },
        "cadence": { "enum": ["daily", "weekly", "monthly", "quarterly"] }
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["country", "industry", "employee_band", "source_class", "provider_key", "channel", "verifier", "persona_role", "icp_id", "workspace_id", "week", "frame_key", "task", "field"]
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "enum": ["wilson", "bootstrap", "none"] }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "at", "breaking", "note"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "breaking": { "type": "boolean" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
