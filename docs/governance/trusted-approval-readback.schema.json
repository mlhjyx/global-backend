{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global.example/governance/trusted-approval-readback.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "repository", "authority_revision", "authority_sha256", "role", "actor_id", "actor_login", "decision_adr", "decision_revision", "policy_revision", "pr_number", "base_sha", "head_sha", "approved_at", "independence", "semantic_sha256", "raw_sha256"],
  "properties": {
    "schema_version": { "const": "product-privacy-approval-readback-receipt/v1" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "repository": { "$ref": "#/$defs/repository" },
    "authority_revision": { "type": "string", "pattern": "^approval-authorities/r[1-9][0-9]*$" },
    "authority_sha256": { "$ref": "#/$defs/digest" },
    "role": { "enum": ["OWN-PRODUCT", "OWN-DATA-PRIVACY", "OWN-QA-EVIDENCE", "OWN-SECURITY", "LEGAL-REVIEW", "MERGE-AUTHORIZER"] },
    "actor_id": { "$ref": "#/$defs/actorId" },
    "actor_login": { "type": "string", "minLength": 1, "maxLength": 256 },
    "decision_adr": { "const": "ADR-042" },
    "decision_revision": { "type": "string", "pattern": "^program-c/decision-r[1-9][0-9]*$" },
    "policy_revision": { "type": "string", "pattern": "^program-c/policy-r[1-9][0-9]*$" },
    "pr_number": { "type": "integer", "minimum": 1 },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "head_sha": { "$ref": "#/$defs/gitSha" },
    "approved_at": { "$ref": "#/$defs/instant" },
    "independence": { "const": "INDEPENDENT" },
    "semantic_sha256": { "$ref": "#/$defs/digest" },
    "raw_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{7,127}$" },
    "repository": { "type": "object", "additionalProperties": false, "required": ["id", "full_name"], "properties": { "id": { "const": 1291151138 }, "full_name": { "const": "mlhjyx/global-backend" } } },
    "actorId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "instant": { "type": "string", "format": "iso-instant" }
  }
}
