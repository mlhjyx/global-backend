{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global.local/schemas/release-bundle-v1.json",
  "title": "Release Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "release_status",
    "environment",
    "release_owner",
    "implementation_commit",
    "released_at",
    "capability_ids",
    "external_provenance",
    "traceability_bindings",
    "scope",
    "promise",
    "source",
    "evidence_ids",
    "operations",
    "data",
    "rollback_and_exit",
    "guides",
    "approval",
    "merge_evidence",
    "learning"
  ],
  "properties": {
    "schema_version": { "const": "release-bundle/v1" },
    "release_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "release_status": { "enum": ["CANDIDATE", "PILOT", "GA", "ROLLED_BACK"] },
    "environment": { "enum": ["development", "test", "pilot", "production"] },
    "release_owner": { "type": "string", "minLength": 1 },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "released_at": { "type": "string", "format": "date-time" },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CAP-" }
    },
    "external_provenance": {
      "description": "PILOT/GA requires either OWNER_SIGNED with verifier PRODUCT_OWNER_SSH_SIGNATURE pointing at a docs/releases/authorizations/*.authorization.json receipt signed by the pinned product-owner SSH key (PRD4-D12, 2026-11-11), or a future VERIFIED/INDEPENDENT_EXTERNAL_READBACK readback. The receipt binds this bundle digest (external_provenance excluded), commit, evidence set, machine check conclusions and review artifact; declared strings alone never authorize promotion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifier", "verification_ref"],
      "properties": {
        "status": { "enum": ["EXTERNAL_UNVERIFIED", "VERIFIED", "OWNER_SIGNED"] },
        "verifier": { "enum": ["NONE", "INDEPENDENT_EXTERNAL_READBACK", "PRODUCT_OWNER_SSH_SIGNATURE"] },
        "verification_ref": {
          "description": "A reference is not proof by itself and must be read back and identity-bound by a trusted verifier.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traceability_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain_id", "capability_id", "evidence_ids"],
        "properties": {
          "chain_id": { "type": "string", "minLength": 1 },
          "capability_id": { "type": "string", "pattern": "^CAP-" },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "scope": { "$ref": "#/$defs/nonEmptyObject" },
    "promise": { "$ref": "#/$defs/nonEmptyObject" },
    "source": { "$ref": "#/$defs/nonEmptyObject" },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "operations": { "$ref": "#/$defs/nonEmptyObject" },
    "data": { "$ref": "#/$defs/nonEmptyObject" },
    "rollback_and_exit": { "$ref": "#/$defs/nonEmptyObject" },
    "guides": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "approval": {
      "description": "Documentary declarations. Under PRD4-D12 a PILOT/GA bundle must carry an OWNER_SIGNED authorization receipt whose signed bundle digest covers these gates and the merge evidence; declared strings alone never authorize promotion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "reviewer", "user_authorization"],
      "properties": {
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provenance", "evidence_ref", "verified_at"],
          "properties": {
            "status": { "enum": ["NOT_VERIFIED", "PASS", "HOLD"] },
            "provenance": { "enum": ["NONE", "CHECK_RUN"] },
            "evidence_ref": { "type": "string", "minLength": 1 },
            "verified_at": { "type": "string", "minLength": 1 }
          }
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provenance", "evidence_ref", "actor", "reviewed_at"],
          "properties": {
            "status": { "enum": ["NOT_REVIEWED", "APPROVED", "CHANGES_REQUESTED"] },
            "provenance": { "enum": ["NONE", "GITHUB_REVIEW"] },
            "evidence_ref": { "type": "string", "minLength": 1 },
            "actor": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "minLength": 1 }
          }
        },
        "user_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provenance", "evidence_ref", "actor", "authorized_at"],
          "properties": {
            "status": { "enum": ["NOT_AUTHORIZED", "AUTHORIZED"] },
            "provenance": { "enum": ["NONE", "SIGNED_AUTHORIZATION"] },
            "evidence_ref": { "type": "string", "minLength": 1 },
            "actor": { "type": "string", "minLength": 1 },
            "authorized_at": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "merge_evidence": {
      "description": "Documentary merge-shape declaration until an independent verifier reads the repository result back and binds it to this bundle.",
      "$ref": "#/$defs/nonEmptyObject"
    },
    "learning": { "$ref": "#/$defs/nonEmptyObject" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "release_status": { "enum": ["PILOT", "GA"] } },
        "required": ["release_status"]
      },
      "then": {
        "properties": {
          "evidence_ids": { "minItems": 1 },
          "traceability_bindings": { "minItems": 1 },
          "external_provenance": {
            "oneOf": [
              {
                "properties": {
                  "status": { "const": "VERIFIED" },
                  "verifier": { "const": "INDEPENDENT_EXTERNAL_READBACK" }
                }
              },
              {
                "properties": {
                  "status": { "const": "OWNER_SIGNED" },
                  "verifier": { "const": "PRODUCT_OWNER_SSH_SIGNATURE" }
                }
              }
            ]
          },
          "approval": {
            "properties": {
              "machine": {
                "properties": {
                  "status": { "const": "PASS" },
                  "provenance": { "const": "CHECK_RUN" },
                  "verified_at": { "format": "date-time" }
                }
              },
              "reviewer": {
                "properties": {
                  "status": { "const": "APPROVED" },
                  "provenance": { "const": "GITHUB_REVIEW" },
                  "reviewed_at": { "format": "date-time" }
                }
              },
              "user_authorization": {
                "properties": {
                  "status": { "const": "AUTHORIZED" },
                  "provenance": { "const": "SIGNED_AUTHORIZATION" },
                  "authorized_at": { "format": "date-time" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyObject": {
      "type": "object",
      "minProperties": 1
    }
  }
}
