  "receipt": {
    "schema": "durable-execution-receipt/v1",
    "author": "trusted-ledger",
    "fields": [
      "operationId",
      "operationKey",
      "resultStrategy",
      "resultSchema",
      "resultDigest",
      "artifactId",
      "usage",
      "costBasis"
    ],
    "rejectsPayloadFields": true,
    "payloadExclusions": [
      "body",
      "prompt",
      "reasoning",
      "rawResponse",
      "responseBody",
      "credentials",
      "tokens",
      "email",
      "personalData"
    ]
  },
