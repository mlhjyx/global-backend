{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "release-authorization/v1",
  "title": "Product-owner release authorization receipt (PRD4-D12)",
  "description": "Signed with the pinned product-owner SSH key (namespace release-authorization). The detached signature lives next to this file as <name>.sig. Every binding is recomputed by scripts/release-authorization.mjs before a PILOT/GA release bundle may pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "decision",
    "release_id",
    "release_status",
    "environment",
    "repository",
    "implementation_commit",
    "release_bundle_sha256",
    "evidence_ids",
    "evidence_set_sha256",
    "machine_check",
    "reviewer_record",
    "authorized_by",
    "authorized_at",
    "valid_until",
    "key_id",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "release-authorization/v1" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "decision": { "const": "AUTHORIZED" },
    "release_id": { "type": "string", "minLength": 1 },
    "release_status": { "enum": ["PILOT", "GA"] },
    "environment": { "enum": ["pilot", "production"] },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical JSON of the release bundle with external_provenance removed."
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the sorted, de-duplicated evidence ids joined with newlines."
    },
    "machine_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "head_sha", "contexts", "fetched_at"],
      "properties": {
        "provider": { "const": "github-actions" },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "conclusion", "run_id", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "conclusion": { "const": "success" },
              "run_id": { "type": "integer" },
              "url": { "type": ["string", "null"] }
            }
          }
        },
        "fetched_at": { "type": "string", "minLength": 1 }
      }
    },
    "reviewer_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "artifact_ref", "artifact_sha256"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "artifact_ref": {
          "type": "string",
          "pattern": "^docs/releases/authorizations/[A-Za-z0-9._-]+\\.review\\.md$"
        },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "authorized_by": { "type": "string", "minLength": 1 },
    "authorized_at": { "type": "string", "minLength": 1 },
    "valid_until": {
      "type": "string",
      "minLength": 1,
      "description": "Must be after authorized_at and at most 30 days later; expired receipts fail closed."
    },
    "key_id": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
