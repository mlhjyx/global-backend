{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global.example/governance/approval-proposal-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "policy_revision",
    "decision_raw_sha256",
    "decision_semantic_sha256",
    "renderer_schema_version",
    "renderer_source_sha256",
    "proposed_sidecar_path",
    "proposed_sidecar_byte_length",
    "proposed_sidecar_raw_sha256"
  ],
  "properties": {
    "schema_version": { "const": "approval-proposal-manifest/v1" },
    "decision_id": { "enum": ["ADR-026", "ADR-027"] },
    "policy_revision": { "type": "string", "pattern": "^program-c/policy-r[1-9][0-9]*$" },
    "decision_raw_sha256": { "$ref": "#/$defs/digest" },
    "decision_semantic_sha256": { "$ref": "#/$defs/digest" },
    "renderer_schema_version": { "const": "approval-sidecar-renderer/v1" },
    "renderer_source_sha256": { "$ref": "#/$defs/digest" },
    "proposed_sidecar_path": { "$ref": "#/$defs/markdownRepoPath" },
    "proposed_sidecar_byte_length": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "proposed_sidecar_raw_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "markdownRepoPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._/-]{1,512}\\.md$" }
  }
}
