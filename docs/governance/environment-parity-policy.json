      "category": "deployment",
      "reason": "Every managed mode, including development, requires production-compiled Node runtime semantics and an explicit real data-processing jurisdiction; the business rules and failure semantics remain identical."
    },
    {
      "id": "runtime-admission-test-process-only",
      "rule": "ENVIRONMENT_BRANCH",
      "path": "apps/api/src/runtime/runtime-admission.ts",
