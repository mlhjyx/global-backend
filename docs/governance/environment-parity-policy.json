  ],
  "migration_allowlist": [
    {
      "id": "historical-sandbox-evidence-license",
      "rule": "SYNTHETIC_PROVIDER_RUNTIME_PATH",
      "path": "apps/api/src/discovery/evidence-license.ts",
      "match_sha256": "sha256:37a81674f8d95fa0b18c2efaee131ac05806c688f5ee60e4263f27b5259b9018",
      "reason": "Temporary compatibility logic identifies sandbox provenance for licensing decisions; it does not register or route a sandbox provider.",
      "target_state": "Quarantine and exclude historical synthetic discovery records from product reads, releases, and evidence, then remove this compatibility branch."
    }
  ],
  "forbidden_runtime_dependencies": [
    "@global/test-support",
    "@global/site-renderer-visual-harness",
    "@global/site-builder-eval-runner"
  ]
