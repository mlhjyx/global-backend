      "category": "deployment",
      "reason": "The product child process is always launched with production runtime semantics from the same managed artifact."
    },
    {
      "id": "renderer-child-production-runtime",
      "rule": "ENVIRONMENT_BRANCH",
      "path": "apps/api/src/site-builder/renderer-build.ts",
      "match_sha256": "sha256:3f227ca065daa60275d40b7e8a6b19ff9471b56b99d31fac67730c64caf36f74",
