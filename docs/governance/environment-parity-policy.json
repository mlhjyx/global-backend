      "rule": "ENVIRONMENT_BRANCH",
      "path": "apps/api/src/runtime/runtime-environment.ts",
      "match_sha256": "sha256:304c588b0bca67e0e43c1707c49f3eff5dd5f8b3c605108e2b7e0d17243394d6",
