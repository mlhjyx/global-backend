      "category": "test-process",
      "reason": "Only the isolated test process is outside managed runtime admission and cannot accept product work."
    },
    {
      "id": "development-loopback-jwks-trust-root",
      "rule": "ENVIRONMENT_BRANCH",
      "path": "apps/api/src/runtime/runtime-admission.ts",
