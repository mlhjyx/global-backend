{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global.local/schemas/delivery-traceability-v1.json",
  "title": "Delivery Traceability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chains"],
  "properties": {
    "schema_version": { "const": "delivery-traceability/v1" },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "capability_id",
          "object_ids",
          "operation_ids",
          "code_paths",
          "test_paths",
          "scenario_ids",
          "delivery_state",
          "evidence_ids",
          "required_evidence_kinds",
          "evidence_expectation"
        ],
        "properties": {
          "chain_id": { "type": "string", "minLength": 1 },
          "capability_id": { "type": "string", "pattern": "^CAP-" },
          "object_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^OBJ-FE-" }
          },
          "operation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "code_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "test_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SCN-FE-" }
          },
          "delivery_state": {
            "enum": ["INTERNAL_ONLY", "PILOT", "GA", "HISTORICAL"]
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "required_evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_expectation": {
            "const": "FRESH_PASS_REQUIRED_FOR_PILOT_OR_GA"
          }
        }
      }
    }
  }
}
