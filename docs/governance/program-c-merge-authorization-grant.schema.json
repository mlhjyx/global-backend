{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global.example/governance/program-c-merge-authorization-grant.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "repository", "decision_adr", "decision_revision", "policy_revision", "stage", "pr_number", "base_sha", "head_sha", "decision_raw_sha256", "decision_semantic_sha256", "allowed_merge_method", "authority_role", "authority_actor_id", "authority_revision", "authority_sha256", "authority_receipt_id", "authority_receipt_core_sha256", "authority_receipt_raw_sha256", "authorized_at", "expires_at", "single_use_nonce"],
  "properties": {
    "schema_version": { "const": "program-c-merge-authorization-grant/v1" },
    "grant_id": { "$ref": "#/$defs/id" },
    "repository": { "$ref": "#/$defs/repository" },
    "decision_adr": { "enum": ["ADR-026", "ADR-027"] },
    "decision_revision": { "type": "string", "pattern": "^program-c/decision-r[1-9][0-9]*$" },
    "policy_revision": { "type": "string", "pattern": "^program-c/policy-r[1-9][0-9]*$" },
    "stage": { "enum": ["PROPOSAL_MERGE", "ACCEPTANCE_MERGE"] },
    "pr_number": { "type": "integer", "minimum": 1 },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "head_sha": { "$ref": "#/$defs/gitSha" },
    "decision_raw_sha256": { "$ref": "#/$defs/digest" },
    "decision_semantic_sha256": { "$ref": "#/$defs/digest" },
    "allowed_merge_method": { "enum": ["MERGE", "SQUASH", "REBASE"] },
    "authority_role": { "const": "MERGE-AUTHORIZER" },
    "authority_actor_id": { "$ref": "#/$defs/actorId" },
    "authority_revision": { "type": "string", "pattern": "^approval-authorities/r[1-9][0-9]*$" },
    "authority_sha256": { "$ref": "#/$defs/digest" },
    "authority_receipt_id": { "$ref": "#/$defs/id" },
    "authority_receipt_core_sha256": { "$ref": "#/$defs/digest" },
    "authority_receipt_raw_sha256": { "$ref": "#/$defs/digest" },
    "authorized_at": { "$ref": "#/$defs/instant" },
    "expires_at": { "$ref": "#/$defs/instant" },
    "single_use_nonce": { "type": "string", "pattern": "^nonce-program-c-[a-z0-9-]{4,96}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{7,127}$" },
    "repository": { "type": "object", "additionalProperties": false, "required": ["id", "full_name"], "properties": { "id": { "const": 1291151138 }, "full_name": { "const": "mlhjyx/global-backend" } } },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "actorId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "instant": { "type": "string", "format": "iso-instant" }
  }
}
